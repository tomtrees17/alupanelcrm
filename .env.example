# Copy to .env in the project root on the server (next to config.php — NOT
# inside public/) and fill in. .env is gitignored: it never reaches GitHub and
# the nightly `git reset --hard` deploy leaves it alone. Then:
#   chown root:www .env && chmod 640 .env

# Anthropic API key (console.anthropic.com → API Keys, starts with sk-ant-api03-)
# Used by the customer industry classification. The inventory assistant also
# needs ai.driver = 'claude' in config.local.php.
ANTHROPIC_API_KEY=

# Google Geocoding API key (Google Cloud → APIs & Services → Credentials).
# Restrict it to the Geocoding API and the server IP 149.129.218.9.
GOOGLE_MAPS_API_KEY=

# 人力 salary encryption key (HR-01): 32 random bytes, base64. Generate ON THE
# SERVER with `openssl rand -base64 32` and keep a copy somewhere safe outside
# the server — salaries saved with it cannot be read without it, and changing it
# makes stored salaries unreadable. Empty = salary fields disabled.
HR_SALARY_KEY=

# Optional — these may instead stay in config.local.php where they are today.
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# WA_TOKEN=
